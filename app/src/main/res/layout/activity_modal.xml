<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E0E">

    <TextView
        android:id="@+id/activity_modal_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_extrabold"
        android:text="Title"
        android:textColor="#FFF"
        android:textSize="34sp"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/activity_modal_tv_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/activity_modal_tv_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/manrope_bold"
        android:text="Message"
        android:textColor="#FFF"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/activity_modal_btn_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_modal_tv_title" />

    <Button
        android:id="@+id/activity_modal_btn_action"
        android:layout_width="wrap_content"
        android:layout_height="53dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#FFF"
        android:fontFamily="@font/manrope_extrabold"
        android:text="BUTTON"
        android:textColor="#000"
        android:textSize="16sp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_modal_tv_message" />

</androidx.constraintlayout.widget.ConstraintLayout>
